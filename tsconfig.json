{
    "compilerOptions": {
        "target": "es2023",
        "module": "es2022",
        "moduleResolution": "bundler",
        "allowUmdGlobalAccess": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["blockbench-types", "blockbench-types/generated/modeling/transform/transform_modules"],
        "rootDir": "src",
        "strict": false,
        "strictNullChecks": false
    },
    "exclude": [
        "node_modules"
    ]
}